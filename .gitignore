# ==========================================
# Edge-LLM Open-Source Dataset .gitignore
# ==========================================

# 1. Ignore Manuscript & Conference Submissions (Keep locally only)
*.docx
*.doc
*.pdf
paper.zip
Engineering_proceedings_Template_ecice2026.docx
ECICE2026_FullPaper_YiChunTeng.docx
ECICE2026_FullPaper_YiChunTeng.pdf

# 2. Ignore Internal Drafts & LaTeX Sources
docs/
paper/

# 3. Microsoft Office Temporary Lock Files
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx

# 4. Python Environment & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
